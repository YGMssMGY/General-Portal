# ============================================================
# General Portal — Environment Configuration
# Copy to .env.local and fill in real values.
# start-dev.ps1 loads .env.local into the process environment.
# ============================================================

# --- Client Branding ---
# "developers" (Developers' Club) or "stuco" (Student Council)
VITE_CLIENT_NAME=developers

# --- Frontend ---
VITE_PORT=5173

# Backend port (used by scripts, not by frontend)
BACKEND_PORT=3001

# --- Dev Authentication ---
# Default credentials for zero-setup login:
#   Username: dev@generalportal.local
#   Password: devpass123
DEV_AUTH_USERNAME=dev@generalportal.local
DEV_AUTH_PASSWORD=devpass123

# --- Database ---
DATABASE_URL=postgresql://general_portal:general_portal@localhost:5432/general_portal

# --- Auth.js Secret (REQUIRED for production) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-in-production-abc123

# Frontend URL (for Auth.js redirects)
AUTH_URL=http://localhost:5173

# --- Optional OAuth2 Providers ---
# GitHub
GITHUB_ID=
GITHUB_SECRET=

# Google
GOOGLE_ID=
GOOGLE_SECRET=

# Microsoft Entra ID
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Optional: Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
