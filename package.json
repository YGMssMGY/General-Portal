{
  "name": "general-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "stop": "node scripts/stop.mjs",
    "dev": "node scripts/stop.mjs && concurrently -n be,fe -c cyan,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "start": "npm run build && npm run start -w backend",
    "start:backend": "npm run start -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:migrate:dev": "npm run db:migrate -w backend",
    "db:migrate:prod": "npm run db:migrate:prod -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:seed:dev": "npm run db:seed -w backend",
    "db:seed:prod": "npm run db:seed:prod -w backend",
    "db:reset": "npm run db:reset -w backend",
    "db:reset:dev": "npm run db:reset -w backend",
    "db:reset:prod": "npm run db:reset:prod -w backend",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:setup:dev": "npm run db:migrate:dev && npm run db:seed:dev",
    "db:setup:prod": "npm run db:migrate:prod && npm run db:seed:prod",
    "format": "prettier --write \"**/*.{ts,tsx,css,json}\"",
    "check-format": "prettier --check \"**/*.{ts,tsx,css,json}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "eslint --cache --cache-strategy content",
    "lint:check": "eslint --max-warnings 0",
    "lint:all": "npm run lint --workspaces --if-present",
    "lint:fix:all": "npm run lint:fix --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "@carbon/charts-react": "^1.27.11",
    "@emoji-mart/react": "^1.1.1"
  }
}
