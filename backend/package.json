{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/prod.js",
    "start:dev": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/dev-setup.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "dotenv -e ../.env.local -- prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:use:prod": "node --input-type=module -e \"import{ copyFileSync }from 'fs';copyFileSync('prisma/schema.prod.prisma','prisma/schema.prisma')\"",
    "db:migrate:prod": "npm run db:use:prod && prisma generate && dotenv -e ../.env.production -- prisma migrate dev",
    "db:seed:prod": "npm run db:use:prod && prisma generate && dotenv -e ../.env.production -- prisma db seed",
    "db:studio:prod": "npm run db:use:prod && prisma generate && dotenv -e ../.env.production -- prisma studio",
    "db:push:prod": "npm run db:use:prod && prisma generate && dotenv -e ../.env.production -- prisma db push",
    "db:setup:prod": "npm run db:push:prod && npm run db:seed:prod"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@auth/prisma-adapter": "^2.11.2",
    "@hono/auth-js": "^1.1.1",
    "@hono/node-server": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "@scalar/hono-api-reference": "^0.10.16",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "helmet": "^8.1.0",
    "hono": "^4.12.18",
    "hono-rate-limiter": "^0.5.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "qrcode": "^1.5.4",
    "vitest": "^4.1.6",
    "ws": "^8.20.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "prisma": "^6.6.0",
    "tsx": "^4.19.4"
  }
}
