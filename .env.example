# ============================================================
# General Portal — Environment Configuration
# ============================================================
# Copy this to .env.local, then fill in your values.
#   cp .env.example .env.local
# ============================================================
# REQUIRED BEFORE RUNNING:
#   1. PostgreSQL running on localhost:5432
#   2. Create database + user (run the SQL below)
#   3. Create an OAuth2 app on GitHub/Google
#   4. Fill in your AUTH_SECRET
#   5. npm run db:setup   (create tables + load sample data)
#   6. npm run dev        (start both servers)
# ============================================================

# ── PostgreSQL Setup ───────────────────────────────────────────
# Run this in psql as a superuser to create the database and user:
#
#   CREATE USER general_portal WITH PASSWORD 'general_portal';
#   CREATE DATABASE general_portal OWNER general_portal;
#
# Then fill in DATABASE_URL below.
#
DATABASE_URL=postgresql://general_portal:general_portal@localhost:5432/general_portal

# ── Auth.js Setup ──────────────────────────────────────────────
# Generate a random secret:
#   openssl rand -base64 32
# This encrypts session data in the database.
AUTH_SECRET=replace-with-random-secret-at-least-32-chars

# ── OAuth2 Provider (PICK ONE) ─────────────────────────────────
# You MUST configure at least one OAuth2 provider to log in.
# The credentials provider (dev login) has been removed for security.
#
# --- Option A: GitHub (easiest) ---
# 1. Go to https://github.com/settings/developers → New OAuth App
# 2. Homepage URL: http://localhost:5173
# 3. Authorization callback URL: http://localhost:5173/api/auth/callback/github
# 4. Copy Client ID and generate a Client Secret
#
GITHUB_ID=
GITHUB_SECRET=
#
# --- Option B: Google ---
# 1. Go to https://console.cloud.google.com/apis/credentials → Create OAuth client ID
# 2. Application type: Web application
# 3. Authorized redirect URI: http://localhost:5173/api/auth/callback/google
#
# GOOGLE_ID=
# GOOGLE_SECRET=
#
# --- Option C: Microsoft Entra ID ---
# MICROSOFT_TENANT_ID=common
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ── Client Branding ───────────────────────────────────────────
#   developers  → "Developers' Club" (logo: DC, shows volunteers)
#   stuco       → "Student Council"  (logo: SC, shows finance)
VITE_CLIENT_NAME=developers

# ── Ports ─────────────────────────────────────────────────────
VITE_PORT=5173
BACKEND_PORT=3001

# ── Auth.js URL ───────────────────────────────────────────────
# The frontend URL for Auth.js redirects. Must match your browser URL.
AUTH_URL=http://localhost:5173

# ── Optional: Redis ───────────────────────────────────────────
# Not required for development.
# REDIS_HOST=localhost
# REDIS_PORT=6379
