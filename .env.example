# Copy this file to .env.local and fill in real values.
# start-dev.ps1 loads .env.local into the backend/frontend process environment.

FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080/api

POSTGRES_URL=jdbc:postgresql://localhost:5432/orgflow
POSTGRES_USER=orgflow
POSTGRES_PASSWORD=orgflow

# Dev authentication (replaces the old ORGFLOW_DEMO_MODE).
# Set a password to enable dev login at POST /api/auth/dev-login.
# Leave password empty to disable dev login (production-safe default).
DEV_AUTH_USERNAME=dev@orgflow.local
DEV_AUTH_PASSWORD=

# Enable developer login form on the frontend (set to true for local dev).
VITE_DEV_AUTH=false

# Microsoft Entra ID app registration values.
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Microsoft Graph REST API base URL.
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Optional Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
