generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  todo
  in_progress
  blocked
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum ProposalType {
  Event
  Purchase
  Project
}

enum ProposalStatus {
  submitted
  under_review
  approved
  rejected
}

enum EventStatus {
  pending
  active
  completed
  cancelled
}

enum TransactionStatus {
  pending
  under_review
  approved
  rejected
}

enum TransactionCategory {
  Printing
  Event
  Food
  Supplies
  Other
}

enum ThreadContext {
  task
  event
  proposal
  general
}

enum ThreadStatus {
  active
  completed
  archived
}

enum FileType {
  Spreadsheet
  PDF
  Document
  Image
  Other
}

enum ActivityResource {
  Finance
  Proposal
  Event
  Task
  File
  Settings
  Member
}

enum MemberVisibility {
  members
  officers
  public
}

enum WorkspaceFileType {
  Spreadsheet
  PDF
  Document
  Image
  Other
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         Membership[]
  tasks               TaskItem[]
  proposals           Proposal[]
  events              EventItem[]
  volunteerSlots      VolunteerSlot[]
  financeTransactions FinanceTransaction[]
  messageThreads      MessageThread[]
  files               WorkspaceFile[]
  activityLogs        ActivityLog[]
  settings            WorkspaceSettings?
  publicEvents        PublicEvent[]
  photos              Photo[]
  trendSnapshots      TrendSnapshot[]
  modules             WorkspaceModule[]
  approvalRules       ApprovalRule[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  meetings            Meeting[]
  recurringTasks      RecurringTask[]
  webhookSubscriptions WebhookSubscription[]
  budgetAllocations   BudgetAllocation[]
  checkIns            CheckIn[]
  termArchives        TermArchive[]
  templates           ClubTemplate[]
  kudos               Kudos[]
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name   String
  password      String?
  emailVerified DateTime?
  image     String?
  xp            Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships Membership[]
  accounts    Account[]
  sessions    Session[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id             String   @id @default(uuid())
  position       String
  accessLabel    String
  taskCount      Int      @default(0)
  volunteerHours Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  permissions PermissionGrant[]

  @@unique([workspaceId, userId])
  @@index([workspaceId])
}

model PermissionGrant {
  id         String   @id @default(uuid())
  permission String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId String

  @@unique([membershipId, permission])
}

model TaskItem {
  id            String       @id @default(uuid())
  title         String
  status        TaskStatus   @default(todo)
  priority      TaskPriority @default(medium)
  project       String?
  dueDate       DateTime?
  assigneeName  String?
  progress      Int          @default(0)
  blockedReason String?
  position      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  subtasks    TaskSubtask[]
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model Proposal {
  id              String         @id @default(uuid())
  title           String
  type            ProposalType
  status          ProposalStatus @default(submitted)
  approvalStep    String         @default("submitted")
  approvalHistory String?
  submittedBy     String
  submittedAt     DateTime
  dateNeeded      DateTime?
  budget          Decimal        @default(0)
  summary         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  attachments ProposalAttachment[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model EventItem {
  id          String      @id @default(uuid())
  title       String
  status      EventStatus @default(pending)
  startsAt    DateTime?
  endsAt      DateTime?
  progress    Int         @default(0)
  budgetUsed  Decimal     @default(0)
  budgetTotal Decimal     @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  owners      EventOwner[]
  checkIns    CheckIn[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, startsAt])
}

model EventOwner {
  id         String   @id @default(uuid())
  ownerLabel String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event   EventItem @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
}

model VolunteerSlot {
  id         String   @id @default(uuid())
  title      String
  eventName  String?
  startsAt   DateTime?
  capacity   Int      @default(0)
  filled     Int      @default(0)
  hours      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  signups     VolunteerSignup[]

  @@index([workspaceId])
}

model FinanceTransaction {
  id          String              @id @default(uuid())
  title       String
  category    TransactionCategory
  status      TransactionStatus   @default(pending)
  submittedBy String
  amount      Decimal             @default(0)
  type        String              @default("expense")
  notes       String?
  occurredAt  DateTime
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  attachments FinanceAttachment[]
  budgetAllocation BudgetAllocation? @relation(fields: [budgetId], references: [id])
  budgetId    String?

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model MessageThread {
  id            String       @id @default(uuid())
  title         String
  context       ThreadContext @default(general)
  status        ThreadStatus @default(active)
  preview       String?
  unreadCount   Int          @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId  String
  participants MessageParticipant[]
  messages     Message[]

  @@index([workspaceId])
}

model MessageParticipant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String
}

model Message {
  id         String   @id @default(uuid())
  authorName String
  body       String
  sentAt     DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  thread      MessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId    String
  attachments MessageAttachment[]
}

model WorkspaceFile {
  id             String   @id @default(uuid())
  name           String
  fileType       String
  ownerName      String
  linkedResource String?
  sizeLabel      String?
  storageKey     String?
  fileUpdatedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([workspaceId])
}

model ActivityLog {
  id            String   @id @default(uuid())
  actorName     String
  action        String
  resourceType  String
  resourceTitle String?
  occurredAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([workspaceId])
  @@index([workspaceId, occurredAt])
}

model WorkspaceSettings {
  id                      String          @id @default(uuid())
  defaultVisibility       MemberVisibility @default(members)
  requireProposalApproval Boolean         @default(false)
  allowMemberInvites      Boolean         @default(true)
  fiscalYearStart         String          @default("January")
  organizationType        String?
  primaryContactEmail     String?
  teamsWebhookUrl         String?
  webhookUrl              String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String   @unique
}

model PublicEvent {
  id          String   @id @default(uuid())
  title       String
  eventDate   DateTime?
  description String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([workspaceId])
}

model Photo {
  id          String   @id @default(uuid())
  title       String
  photoDate   DateTime?
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([workspaceId])
}

model TaskSubtask {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   TaskItem @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
}

model TaskComment {
  id         String   @id @default(uuid())
  authorName String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task   TaskItem @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
}

model TaskAttachment {
  id         String   @id @default(uuid())
  name       String
  fileType   String
  sizeLabel  String?
  storageKey String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task   TaskItem @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
}

model ProposalAttachment {
  id         String   @id @default(uuid())
  name       String
  fileType   String
  sizeLabel  String?
  storageKey String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String
}

model VolunteerSignup {
  id          String   @id @default(uuid())
  memberName  String
  status      String   @default("registered")
  hoursLogged Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slot   VolunteerSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  slotId String
}

model FinanceAttachment {
  id         String   @id @default(uuid())
  name       String
  fileType   String
  sizeLabel  String?
  storageKey String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transaction   FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
}

model MessageAttachment {
  id         String   @id @default(uuid())
  name       String
  fileType   String
  sizeLabel  String?
  storageKey String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
}

model TrendSnapshot {
  id          String   @id @default(uuid())
  metricKey   String
  metricValue Float
  recordedAt  DateTime
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([workspaceId])
}

model WorkspaceModule {
  id         String   @id @default(uuid())
  moduleKey  String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([workspaceId, moduleKey])
}

model ApprovalRule {
  id           String   @id @default(uuid())
  triggerType  String
  triggerValue String
  approverIds  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([workspaceId])
}

model Notification {
  id           String   @id @default(uuid())
  workspaceId  String
  userId       String
  title        String
  body         String
  type         String
  resourceType String?
  resourceId   String?
  isRead       Boolean  @default(false)
  emailedAt    DateTime?
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AuditLog {
  id           String   @id @default(uuid())
  workspaceId  String
  actorId      String?
  actorName    String
  action       String
  resourceType String
  resourceId   String?
  resourceTitle String?
  metadata     String?
  ipAddress    String?
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, actorId])
}

model Meeting {
  id          String   @id @default(uuid())
  workspaceId String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  agenda      String?
  minutes     String?
  actionItems String?
  status      String   @default("scheduled")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rsvps     MeetingRsvp[]

  @@index([workspaceId])
}

model MeetingRsvp {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  userName  String
  response  String
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  @@unique([meetingId, userId])
}

model RecurringTask {
  id            String   @id @default(uuid())
  workspaceId   String
  title         String
  description   String?
  priority      String   @default("medium")
  assigneeName  String?
  frequency     String
  intervalDays  Int?
  dayOfWeek     Int?
  dayOfMonth    Int?
  nextDueDate   DateTime
  lastGenerated DateTime?
  isActive      Boolean  @default(true)
  project       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WebhookSubscription {
  id            String   @id @default(uuid())
  workspaceId   String
  url           String
  events        String
  secret        String
  isActive      Boolean  @default(true)
  lastTriggered DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model BudgetAllocation {
  id            String   @id @default(uuid())
  workspaceId   String
  proposalId    String?
  title         String
  amount        Decimal  @default(0)
  status        String   @default("requested")
  approvedBy    String?
  approvedAt    DateTime?
  reconciledAt  DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financeTransactions FinanceTransaction[]

  @@index([workspaceId])
}

model CheckIn {
  id          String   @id @default(uuid())
  workspaceId String
  eventId     String
  userId      String
  userName    String
  checkedInAt DateTime @default(now())
  hoursLogged Float    @default(0)
  verifiedBy  String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event     EventItem @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([eventId])
}

model TermArchive {
  id          String   @id @default(uuid())
  workspaceId String
  label       String
  startedAt   DateTime
  endedAt     DateTime
  isCurrent   Boolean  @default(false)
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ClubTemplate {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  type        String
  tasks       String
  budget      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Kudos {
  id          String   @id @default(uuid())
  workspaceId String
  fromUserId  String
  toUserId    String
  message     String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
