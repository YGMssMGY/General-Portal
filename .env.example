# ============================================================
# General Portal — Environment Configuration
# ============================================================
# Copy this file to .env.local for development.
#   cp .env.example .env.local
# The backend loads these at startup; Vite exposes VITE_* to the browser.
# ============================================================

# ── Client Branding ──────────────────────────────────────────
# Controls the UI identity. Changes app name, logo initials,
# tagline, and feature visibility throughout the interface.
#   developers  → "Developers' Club" (logo: DC, shows volunteers)
#   stuco       → "Student Council"  (logo: SC, shows finance)
VITE_CLIENT_NAME=developers

# ── Frontend Dev Server ─────────────────────────────────────
VITE_PORT=5173

# ── Backend Port ─────────────────────────────────────────────
# Used by start scripts. The Vite proxy forwards /api/* here.
BACKEND_PORT=3001

# ── Dev Authentication (credentials provider) ───────────────
# These credentials are checked by Auth.js's credentials provider.
# Leave DEV_AUTH_PASSWORD empty to disable dev auth entirely.
DEV_AUTH_USERNAME=dev@generalportal.local
DEV_AUTH_PASSWORD=devpass123

# ── Database (PostgreSQL via Docker) ────────────────────────
# Prisma connects using this URL. The docker-compose.yml
# spins up PostgreSQL matching these defaults.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://general_portal:general_portal@localhost:5432/general_portal

# ── Auth.js Secret (REQUIRED for production) ─────────────────
# Auth.js uses this to encrypt JWT tokens and session cookies.
# Generate a secure random value for production:
#   openssl rand -base64 32
# For development the built-in default is fine.
AUTH_SECRET=dev-secret-change-in-production-abc123

# ── Auth.js URL ──────────────────────────────────────────────
# The public URL of your frontend. Auth.js uses this to
# construct correct callback URLs for OAuth2 flows.
# Must match where the browser accesses the app.
AUTH_URL=http://localhost:5173

# ── Optional OAuth2 Providers ────────────────────────────────
# Enable one or more by filling in credentials.
# When none are set, only the credentials provider (dev login) is active.

# GitHub OAuth2
# Register at: https://github.com/settings/developers
# Callback URL: http://localhost:5173/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth2
# Register at: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:5173/api/auth/callback/google
GOOGLE_ID=
GOOGLE_SECRET=

# Microsoft Entra ID OAuth2
# Register at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Callback URL: http://localhost:5173/api/auth/callback/microsoft
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Optional: Redis ──────────────────────────────────────────
# Used for session store and caching in production.
# Not required for development.
REDIS_HOST=localhost
REDIS_PORT=6379
