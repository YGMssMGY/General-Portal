# ============================================================
# General Portal — Environment Configuration
# ============================================================
# Copy to .env, then fill in what you need.
#   cp .env.example .env
# ============================================================
# QUICK START:
# 1. Create PostgreSQL databases:
#    createdb general_portal_dev
#    createdb general_portal_stuco
# 2. npm install
# 3. npm run dev
# 4. Visit http://localhost:3000
# ============================================================

# ── Database ──────────────────────────────────────────────────
# Two PostgreSQL databases, one per portal (developers / stuco).
# Update credentials as needed for your local PostgreSQL.
DATABASE_URL_DEVELOPERS=postgresql://localhost:5432/general_portal_dev
DATABASE_URL_STUCO=postgresql://localhost:5432/general_portal_stuco

# ── Auth.js ───────────────────────────────────────────────────
# Required for session encryption. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=dev-secret-change-in-production-abc123

# ── Auth.js URL ───────────────────────────────────────────────
# The frontend URL for Auth.js redirects. Must match Entra redirect URI.
AUTH_URL=http://localhost:3000

# ── Microsoft OAuth2 (required in production) ─────────────────
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# ── Ports ─────────────────────────────────────────────────────
# Dev: Vite on 3000, backend API on 30001
# Prod: Hono server on 3000 (serves both frontend dist + API)
BACKEND_PORT=30001
PROD_PORT=3000

# ── Frontend Origin (CORS) ────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── File Uploads ──────────────────────────────────────────────
UPLOADS_DIR=./uploads

# ── Rate Limiting ─────────────────────────────────────────────
# RATE_LIMIT_MAX=100

# ── Sentry (optional) ─────────────────────────────────────────
# SENTRY_DSN=https://key@o123.ingest.sentry.io/123

# ── Public API Key (optional) ─────────────────────────────────
# Used to access /api/v1/* endpoints. Generate with: openssl rand -hex 32
# API_KEY=

# ── Teams Webhook (optional) ──────────────────────────────────
# TEAMS_WEBHOOK_URL=https://yourdomain.webhook.office.com/...

# ── NODE_ENV ──────────────────────────────────────────────────
# Set to "production" to enable Microsoft OAuth2 only.
# NOTE: If set here, Vite will refuse it. Set it as a system env var instead.
# NODE_ENV=production
