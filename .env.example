# ============================================================
# General Portal — Environment Configuration
# ============================================================
# Copy to .env.local, then fill in what you need.
#   cp .env.example .env.local
# ============================================================
# QUICK START:
# 1. npm install
# 2. npm run dev
# Login with: dev.admin@generalportal.local / devpass123
# ============================================================

# ── Database ──────────────────────────────────────────────────
# SQLite (dev):   file:./dev.db (or dev-stuco.db for stuco client)
# PostgreSQL (prod): postgresql://USER:PASS@HOST:PORT/DB
DATABASE_URL=file:./dev.db

# ── Dev Auth ──────────────────────────────────────────────────
# Seeded users all use this password. Custom-created users have their own.
# When DEV_AUTH_PASSWORD is set, any seeded user can log in
# with their email and this password. Leave empty for OAuth2-only.
#
# Dev accounts (password: devpass123):
#   dev.admin@generalportal.local     → Admin
#   dev.president@generalportal.local → President
#   dev.officer@generalportal.local   → Officer
#   dev.member@generalportal.local    → Member
#
DEV_AUTH_PASSWORD=devpass123

# ── Auth.js ───────────────────────────────────────────────────
# Required for session encryption. Generate with:
#   openssl rand -base64 32
#
AUTH_SECRET=dev-secret-change-in-production-abc123

# ── Auth.js URL ───────────────────────────────────────────────
# The frontend URL for Auth.js redirects.
#
AUTH_URL=http://localhost:5173

# ── Client Branding ───────────────────────────────────────────
# developers → Developers' Club | stuco → Student Council
VITE_CLIENT_NAME=developers

# ── Ports ─────────────────────────────────────────────────────
VITE_PORT=5173
BACKEND_PORT=3001

# ── Microsoft OAuth2 (required for production) ────────────────
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# ── Teams Webhook (optional) ──────────────────────────────────
# Incoming webhook URL from a Teams channel. Notifications will be
# posted here. Create one in Teams: channel ... Connectors ... Incoming Webhook
# TEAMS_WEBHOOK_URL=https://yourdomain.webhook.office.com/...

# ── Public API Key (optional) ─────────────────────────────────
# Used to access /api/v1/* endpoints. Generate with: openssl rand -hex 32
# API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────
# RATE_LIMIT_MAX=100

# ── Data Retention ────────────────────────────────────────────
# DATA_RETENTION_DAYS=365

# ── NODE_ENV ──────────────────────────────────────────────────
# Set to "production" to disable dev auth (forces Microsoft OAuth2 only)
# NODE_ENV=production
