# ============================================================
# General Portal — Environment Configuration
# ============================================================
# Copy this to .env.local, then fill in what you need.
#   cp .env.example .env.local
# ============================================================
# QUICK START (dev with SQLite — zero setup):
# 1. npm install
# 2. npm run dev
#
# That's it. SQLite auto-creates, auto-seeds, auto-resets.
# No PostgreSQL, no Docker, no OAuth2 needed for dev.
# Login with: dev@generalportal.local / devpass123
# ============================================================

# ── Database ──────────────────────────────────────────────────
# SQLite (dev default): file path relative to backend/prisma/
#   Default: file:./dev.db  (auto-created, auto-seeded)
# PostgreSQL (prod):      postgresql://USER:PASS@HOST:PORT/DB
#
DATABASE_URL=file:./dev.db

# ── Dev Auth (credentials provider) ───────────────────────────
# When DEV_AUTH_PASSWORD is set, a credentials-based login
# provider is enabled alongside any OAuth2 providers.
# Leave empty to force OAuth2-only login.
#
DEV_AUTH_USERNAME=dev@generalportal.local
DEV_AUTH_PASSWORD=devpass123

# ── Auth.js Secret ────────────────────────────────────────────
# Required for session encryption. Generate with:
#   openssl rand -base64 32
#
AUTH_SECRET=dev-secret-change-in-production-abc123

# ── Auth.js URL ───────────────────────────────────────────────
# The frontend URL for Auth.js redirects.
#
AUTH_URL=http://localhost:5173

# ── Client Branding ───────────────────────────────────────────
#   developers  → "Developers' Club" (logo: DC, show volunteers)
#   stuco       → "Student Council"  (logo: SC, show finance)
#
VITE_CLIENT_NAME=developers

# ── Ports ─────────────────────────────────────────────────────
VITE_PORT=5173
BACKEND_PORT=3001

# ── Optional OAuth2 Providers ─────────────────────────────────
# These are optional. If empty, only dev credentials login works.
#
# GitHub — https://github.com/settings/developers
# GITHUB_ID=
# GITHUB_SECRET=
#
# Google — https://console.cloud.google.com/apis/credentials
# GOOGLE_ID=
# GOOGLE_SECRET=
#
# Microsoft Entra ID — https://portal.azure.com/
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
