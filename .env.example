# ============================================================
# General Portal — Environment Configuration
# Copy to .env.local and fill in real values.
# start-dev.ps1 loads .env.local into the process environment.
# ============================================================

# --- Frontend ---
# Frontend dev server port (default: 5173)
VITE_PORT=5173

# Leave empty for Vite proxy mode (recommended for dev).
# Set to full URL only when connecting to a remote backend.
VITE_API_URL=

# Backend port (used by scripts, not by frontend)
BACKEND_PORT=8080

# --- Frontend Origin (for CORS) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Dev Authentication ---
# Default credentials for zero-setup login:
#   Username: dev@general-portal.local
#   Password: devpass123
# The backend auto-provisions this user as Admin on first login.
# Leave password empty to disable dev login (production-safe default).
DEV_AUTH_USERNAME=dev@general-portal.local
DEV_AUTH_PASSWORD=devpass123

# Set to "true" to use MSW mock mode (no backend needed). Default: false (real backend).
VITE_USE_MSW=false

# --- Database (PostgreSQL) ---
POSTGRES_URL=jdbc:postgresql://localhost:5432/general_portal
POSTGRES_USER=general_portal
POSTGRES_PASSWORD=general_portal

# --- Microsoft Entra ID (OAuth2) ---
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Microsoft Graph REST API base URL.
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# --- Backend Feature Flags ---
GENERAL_PORTAL_AUTO_PROVISION_USERS=true
GENERAL_PORTAL_SEED_ENABLED=true
GENERAL_PORTAL_DEMO_MODE=false
GENERAL_PORTAL_OFFICER_ROLE_ENABLED=true

# --- Optional: Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
